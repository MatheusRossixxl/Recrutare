import type { Job, Candidate } from "@prisma/client";

export interface ResumeExtraction {
  name?: string;
  email?: string;
  phone?: string;
  city?: string;
  desiredRole?: string;
  desiredRoles?: string;
  professionalSummary?: string;
  birthDate?: string;
  secondaryEmail?: string;
  linkedin?: string;
  portfolio?: string;
  education?: string;
  courses?: string;
  experience?: string;
  skills?: string[];
  languages?: string[];
  salaryExpectation?: number | null;
  hasDriverLicense?: boolean | null;
  driverLicenseCategory?: string;
  gender?: string;
  race?: string;
  sexualOrientation?: string;
  genderIdentity?: string;
  address?: string;
  country?: string;
  summary: string;
}

export interface CandidateJobAnalysis {
  summary: string;
  strengths: string[];
  concerns: string[];
  requirementsFound: string[];
  requirementsMissing: string[];
  relevantExperience: string[];
  suggestedQuestions: string[];
  matchScore: number;
  disclaimer: string;
}

const DISCLAIMER =
  "Esta análise é uma ferramenta de apoio à triagem. A decisão final sobre avançar ou não o candidato é sempre do recrutador.";

function clean(value?: string | null): string | undefined {
  if (!value) return undefined;

  const normalized = value
    // Remove números de página comuns em currículos: "1 / 6", "2/6", etc.
    .replace(/\b\d+\s*\/\s*\d+\b/g, " ")
    // Remove espaços excessivos.
    .replace(/[ \t]+/g, " ")
    .replace(/\n{3,}/g, "\n\n")
    .trim();

  return normalized || undefined;
}

function extractEmail(text: string): string | undefined {
  return clean(text.match(/[\w.+-]+@[\w-]+\.[\w.-]+/)?.[0]);
}

function extractPhone(text: string): string | undefined {
  const match = text.match(
    /(?:\+?55\s?)?(?:\(?\d{2}\)?\s?)?(?:9\s?)?\d{4,5}[-.\s]?\d{4}/
  );

  return clean(match?.[0]);
}

function extractLinkedin(text: string): string | undefined {
  const match = text.match(
    /https?:\/\/(?:www\.)?linkedin\.com\/[^\s)]+/i
  );

  return clean(match?.[0]);
}

function extractPortfolio(text: string): string | undefined {
  const match = text.match(
    /https?:\/\/(?!www\.linkedin\.com)[^\s)]+/i
  );

  return clean(match?.[0]);
}

function extractName(text: string): string | undefined {
  const lines = text
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const ignored = [
    "currículo",
    "curriculum",
    "curriculum vitae",
    "experiência profissional",
    "formação",
    "formação acadêmica",
    "educação",
    "habilidades",
    "competências",
    "objetivo",
    "perfil profissional",
    "contato",
  ];

  for (const line of lines.slice(0, 15)) {
    if (
      line.length >= 5 &&
      line.length <= 80 &&
      !line.includes("@") &&
      !/\d{4,}/.test(line) &&
      !ignored.some((item) => line.toLowerCase() === item)
    ) {
      return clean(line);
    }
  }

  return undefined;
}

function extractCity(text: string): string | undefined {
  const patterns = [
    /(?:cidade|localidade|residência|residencia)\s*[:\-]\s*([^\n]+)/i,
    /(?:endereço|endereco).*?,\s*([^,\n]+)\s*[-/]\s*([A-Z]{2})/i,
  ];

  for (const pattern of patterns) {
    const match = text.match(pattern);
    if (match) {
      return clean(match[1]);
    }
  }

  return undefined;
}

function normalize(value: string): string {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, " ");
}

function normalizeHeading(value: string): string {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function isSectionHeading(line: string): boolean {
  const normalized = normalizeHeading(line);

  const headings = [
    "experiencia profissional",
    "experiencia",
    "formacao academica",
    "formacao",
    "educacao",
    "cursos e certificacoes",
    "cursos",
    "certificacoes",
    "habilidades",
    "competencias",
    "skills",
    "idiomas",
    "languages",
    "objetivo",
    "perfil profissional",
    "resumo profissional",
    "informacoes adicionais",
    "informacoes pessoais",
    "diversidade",
  ];

  return headings.includes(normalized);
}

function removePageNumbers(text: string): string {
  return text
    .replace(/^\s*\d+\s*\/\s*\d+\s*$/gm, "")
    .replace(/[ \t]+/g, " ")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}

function extractSection(text: string, headings: string[]): string | undefined {
  const lines = text.split(/\r?\n/);

  const normalize = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim()
      .toLowerCase();

  const headingSet = headings.map(normalize);

  let start = -1;

  for (let i = 0; i < lines.length; i++) {
    const current = normalize(lines[i]);

    if (
      headingSet.some(
        (heading) =>
          current === heading ||
          current.startsWith(`${heading}:`)
      )
    ) {
      start = i + 1;
      break;
    }
  }

  if (start === -1) return undefined;

  const knownSections = [
    "experiencia profissional",
    "experiencia",
    "formacao academica",
    "formacao",
    "educacao",
    "educacao formal",
    "cursos e certificacoes",
    "cursos",
    "certificacoes",
    "habilidades",
    "competencias",
    "skills",
    "idiomas",
    "linguas",
    "languages",
    "objetivo",
    "perfil profissional",
    "resumo profissional",
    "resumo",
    "informacoes adicionais",
    "informacoes pessoais",
    "diversidade",
  ].map(normalize);

  const result: string[] = [];

  for (let i = start; i < lines.length; i++) {
    const original = lines[i].trim();
    const current = normalize(original);

    if (
      knownSections.some(
        (section) =>
          current === section ||
          current.startsWith(`${section}:`)
      )
    ) {
      break;
    }

    // Remove números de página do texto extraído do PDF
    if (
      /^p[aá]gina\s+\d+(\s+de\s+\d+)?$/i.test(original) ||
      /^\d+\s*\/\s*\d+$/.test(original) ||
      /^p[aá]gina\s+\d+\s*\/\s*\d+$/i.test(original)
    ) {
      continue;
    }

    if (original) {
      result.push(original);
    } else if (result.length > 0 && result[result.length - 1] !== "") {
      result.push("");
    }
  }

  while (result.length && result[0] === "") result.shift();
  while (result.length && result[result.length - 1] === "") result.pop();

  if (result.length === 0) return undefined;

  return result
    .join("\n")
    .replace(/[ \t]+/g, " ")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}


function extractSkills(text: string): string[] {
  const section = extractSection(text, [
    "habilidades",
    "competências",
    "competencias",
    "skills",
  ]);

  if (!section) return [];

  const lines = section
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const skills: string[] = [];
  let currentParts: string[] = [];

  const levelRegex = /\b(básico|basico|intermediário|intermediario|avançado|avancado)\b/i;

  for (const rawLine of lines) {
    let line = rawLine
      .replace(/^[-•|]+/, "")
      .replace(/\s+/g, " ")
      .trim();

    if (!line) continue;

    /*
     * O PDF normalmente coloca a habilidade e, depois,
     * o nível em outra linha.
     *
     * Exemplo:
     * PLANEJAMENTO -
     * Intermediário
     *
     * ou:
     * EXPERIÊNCIA COM GESTÃO DE EQUIPES -
     * Avançado
     *
     * A habilidade termina sempre no nível.
     */

    const levelMatch = line.match(levelRegex);

    if (levelMatch) {
      const beforeLevel = line
        .slice(0, levelMatch.index)
        .replace(/\s*[-–—:]\s*$/, "")
        .trim();

      if (beforeLevel) {
        currentParts.push(beforeLevel);
      }

      const skillName = currentParts
        .join(" ")
        .replace(/\s+/g, " ")
        .replace(/\s*[-–—:]\s*$/, "")
        .trim();

      const level = levelMatch[1]
        .toLowerCase()
        .replace("basico", "Básico")
        .replace("básico", "Básico")
        .replace("intermediario", "Intermediário")
        .replace("intermediário", "Intermediário")
        .replace("avancado", "Avançado")
        .replace("avançado", "Avançado");

      if (skillName) {
        skills.push(`${skillName} - ${level}`);
      }

      currentParts = [];
      continue;
    }

    /*
     * Se ainda não apareceu o nível, esta linha pertence
     * à habilidade atual. Isso permite tratar habilidades
     * quebradas em várias linhas pelo PDF.
     */
    currentParts.push(line);
  }

  /*
   * Caso exista alguma habilidade no final do currículo
   * sem nível, preservamos ela em vez de descartá-la.
   */
  if (currentParts.length > 0) {
    const remaining = currentParts
      .join(" ")
      .replace(/\s+/g, " ")
      .replace(/\s*[-–—:]\s*$/, "")
      .trim();

    if (remaining) {
      skills.push(remaining);
    }
  }

  /*
   * Remove duplicatas sem limitar a quantidade.
   * Assim, se uma vaga exigir uma habilidade que esteja
   * depois da 40ª, ela continuará disponível.
   */
  return skills.filter(
    (skill, index, array) =>
      array.findIndex(
        (item) => item.toLowerCase() === skill.toLowerCase()
      ) === index
  );
}

function extractLanguages(text: string): string[] {
  const section = extractSection(text, [
    "idiomas",
    "línguas",
    "linguas",
    "languages",
  ]);

  if (!section) return [];

  const languageNames = [
    "português",
    "portugues",
    "inglês",
    "ingles",
    "espanhol",
    "francês",
    "frances",
    "italiano",
    "alemão",
    "alemao",
    "mandarim",
    "japonês",
    "japones",
  ];

  const levels = [
    "básico",
    "basico",
    "intermediário",
    "intermediario",
    "avançado",
    "avancado",
    "fluente",
    "nativo",
  ];

  const lines = section
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const result: string[] = [];

  for (let i = 0; i < lines.length; i++) {
    let line = lines[i]
      .replace(/^[-•|]+/, "")
      .replace(/\s+/g, " ")
      .trim();

    if (!line) continue;

    const normalized = normalize(line);

    const foundLanguage = languageNames.find((language) =>
      normalized.includes(normalize(language))
    );

    if (!foundLanguage) continue;

    let languageText = line;

    // Caso o nível esteja na mesma linha:
    // INGLÊS - AVANÇADO
    const sameLineLevel = levels.find((level) =>
      normalized.includes(normalize(level))
    );

    if (sameLineLevel) {
      const levelText = line.match(
        /(básico|basico|intermediário|intermediario|avançado|avancado|fluente|nativo)/i
      );

      if (levelText) {
        languageText = `${line.replace(/\s*[-–—:]\s*$/, "").trim()} - ${levelText[1]}`;
      }
    } else {
      // Caso o PDF tenha separado:
      //
      // INGLÊS -
      // Avançado
      //
      // Procura o nível nas próximas linhas.
      for (let j = i + 1; j < Math.min(i + 3, lines.length); j++) {
        const next = lines[j].trim();

        const nextLevel = levels.find(
          (level) => normalize(next) === normalize(level)
        );

        if (nextLevel) {
          languageText = `${line.replace(/\s*[-–—:]\s*$/, "").trim()} - ${next}`;
          i = j;
          break;
        }
      }
    }

    languageText = languageText
      .replace(/\s*[-–—:]\s*$/, "")
      .replace(/\s+/g, " ")
      .trim();

    if (
      languageText &&
      !result.some(
        (item) => normalize(item) === normalize(languageText)
      )
    ) {
      result.push(languageText);
    }
  }

  return result.slice(0, 20);
}


function extractDesiredRoles(text: string): string | undefined {
  const lines = text.split(/\r?\n/);

  const headings = [
    "cargos de interesse",
    "cargo(s) de interesse",
    "cargos pretendidos",
    "cargos desejados",
    "área de interesse",
    "areas de interesse",
    "objetivo profissional",
  ];

  const normalizedHeading = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();

  const normalizedHeadings = headings.map(normalizedHeading);

  const sectionHeadings = [
    "resumo profissional",
    "perfil profissional",
    "experiencia profissional",
    "experiencia",
    "formacao academica",
    "formacao",
    "educacao",
    "cursos",
    "certificacoes",
    "habilidades",
    "competencias",
    "skills",
    "idiomas",
    "languages",
    "pretensao salarial",
    "cnh",
    "endereco",
    "pais",
  ];

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (!line) continue;

    const normalized = normalizedHeading(line);

    const inlineMatch = line.match(
      /^(cargo\(s\)\s+de\s+interesse|cargos\s+de\s+interesse|cargos\s+pretendidos|cargos\s+desejados|área\s+de\s+interesse|areas\s+de\s+interesse|objetivo\s+profissional)\s*[:\-]\s*(.+)$/i
    );

    if (inlineMatch?.[2]) {
      return inlineMatch[2].replace(/\s+/g, " ").trim();
    }

    if (!normalizedHeadings.includes(normalized)) continue;

    const values: string[] = [];

    for (let j = i + 1; j < lines.length; j++) {
      const value = lines[j].trim();

      if (!value) continue;

      const nextNormalized = normalizedHeading(value);

      if (sectionHeadings.includes(nextNormalized)) {
        break;
      }

      if (
        /^(cargo\(s\)\s+de\s+interesse|cargos\s+de\s+interesse)\s*:?\s*$/i.test(
          value
        )
      ) {
        continue;
      }

      values.push(value);
    }

    if (values.length) {
      return values.join(" ").replace(/\s+/g, " ").trim();
    }
  }

  return undefined;
}

function extractBirthDate(text: string): string | undefined {
  const dateRegex = /(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})/;

  const convertDate = (match: RegExpMatchArray): string | undefined => {
    const day = Number(match[1]);
    const month = Number(match[2]);
    const year = Number(match[3]);

    const date = new Date(year, month - 1, day);

    if (
      date.getFullYear() !== year ||
      date.getMonth() !== month - 1 ||
      date.getDate() !== day
    ) {
      return undefined;
    }

    return `${year.toString().padStart(4, "0")}-${month
      .toString()
      .padStart(2, "0")}-${day.toString().padStart(2, "0")}`;
  };

  // Procura diretamente no texto inteiro.
  // Exemplo: "Data de nascimento\n04/10/1983"
  const birthDateMatch = text.match(
    /data\s+de\s+nascimento[\s\S]{0,100}?(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})/i
  );

  if (birthDateMatch) {
    const dateMatch = birthDateMatch[1].match(dateRegex);

    if (dateMatch) {
      const result = convertDate(dateMatch);
      if (result) return result;
    }
  }

  // Também aceita "Nascimento: 04/10/1983"
  const birthDateInline = text.match(
    /(?:nascimento|nascida\s+em|nascido\s+em)\s*[:\-]?\s*(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})/i
  );

  if (birthDateInline) {
    const dateMatch = birthDateInline[1].match(dateRegex);

    if (dateMatch) {
      const result = convertDate(dateMatch);
      if (result) return result;
    }
  }

  return undefined;
}

function extractSalary(text: string): number | null {
  const match = text.match(
    /(?:pretensão salarial|pretens[aã]o|sal[aá]rio pretendido|pretendo ganhar)[^\d]{0,30}R?\$?\s*([\d.]+(?:,\d{2})?)/i
  );

  if (!match) return null;

  const value = Number(match[1].replace(/\./g, "").replace(",", "."));

  return Number.isFinite(value) ? value : null;
}

function extractDriverLicense(text: string): {
  hasDriverLicense: boolean | null;
  driverLicenseCategory?: string;
} {
  const lower = text.toLowerCase();

  if (
    /não possuo cnh|nao possuo cnh|não tenho cnh|nao tenho cnh|sem cnh/.test(
      lower
    )
  ) {
    return { hasDriverLicense: false };
  }

  const match = lower.match(
    /\b(?:cnh|habilitação|habilitacao)\b[^\n]{0,50}?(?:categoria|cat\.?)?\s*([a-e](?:,\s*[a-e])*)\b/i
  );

  if (match) {
    return {
      hasDriverLicense: true,
      driverLicenseCategory: match[1].toUpperCase(),
    };
  }

  if (/\bpossuo cnh\b|\btenho cnh\b|\bcnh\b/.test(lower)) {
    return { hasDriverLicense: true };
  }

  return { hasDriverLicense: null };
}

function extractGender(text: string): string | undefined {
  const match = text.match(
    /(?:sexo)\s*[:\-]?\s*(mulher|homem|feminino|masculino|não informado|nao informado)/i
  );

  return clean(match?.[1]);
}

function extractRace(text: string): string | undefined {
  const match = text.match(
    /(?:raça\/cor|raça|raca\/cor|raca)\s*[:\-]?\s*(branca|preta|parda|amarela|indígena|indigena|não informado|nao informado)/i
  );

  return clean(match?.[1]);
}

function extractSexualOrientation(text: string): string | undefined {
  const match = text.match(
    /(?:orientação sexual|orientacao sexual)\s*[:\-]?\s*(heterossexual|homossexual|bissexual|assexual|pansexual|não informado|nao informado)/i
  );

  return clean(match?.[1]);
}

function extractGenderIdentity(text: string): string | undefined {
  const match = text.match(
    /(?:gênero|genero|identidade de gênero|identidade de genero)\s*[:\-]?\s*(cisgênero|cisgenero|transgênero|transgenero|não binário|nao binario|não informado|nao informado)/i
  );

  return clean(match?.[1]);
}


function buildSummary(data: ResumeExtraction, resumeText: string): string {
  const lines = resumeText.split(/\r?\n/);
  const result: string[] = [];

  const summaryHeadings = [
    "resumo profissional",
    "perfil profissional",
    "resumo",
  ];

  const stopHeadings = [
    "cargo(s) de interesse",
    "cargos de interesse",
    "cargo de interesse",
    "cargo pretendido",
    "formação acadêmica",
    "formacao academica",
    "formação",
    "formacao",
    "educação",
    "educacao",
    "cursos e certificações",
    "cursos e certificacoes",
    "cursos",
    "certificações",
    "certificacoes",
    "experiência profissional",
    "experiencia profissional",
    "experiência",
    "experiencia",
    "habilidades",
    "competências",
    "competencias",
    "skills",
    "idiomas",
    "languages",
  ];

  let insideSummary = false;

  for (const rawLine of lines) {
    const line = rawLine.trim();

    if (!line) {
      if (insideSummary && result.length > 0) {
        result.push("");
      }
      continue;
    }

    const normalized = normalize(line);

    if (!insideSummary) {
      if (summaryHeadings.some((heading) => normalized === normalize(heading))) {
        insideSummary = true;
      }
      continue;
    }

    if (
      stopHeadings.some(
        (heading) =>
          normalized === normalize(heading) ||
          normalized.startsWith(normalize(heading) + ":")
      )
    ) {
      break;
    }

    result.push(line);
  }

  while (result.length && result[0] === "") result.shift();
  while (result.length && result[result.length - 1] === "") result.pop();

  return result.join("\n").replace(/\n{3,}/g, "\n\n").trim();
}

class AIService {
  async analyzeResume(resumeText: string): Promise<ResumeExtraction> {
    // Limpa elementos artificiais inseridos pela extração do PDF.
    resumeText = resumeText
      .replace(/^\s*Página\s+\d+(?:\s+de\s+\d+)?\s*$/gim, "")
      .replace(/^\s*Pagina\s+\d+(?:\s+de\s+\d+)?\s*$/gim, "")
      .replace(/^\s*Página\s+\d+\s*\/\s*\d+\s*$/gim, "")
      .replace(/^\s*Pagina\s+\d+\s*\/\s*\d+\s*$/gim, "")
      .replace(/^\s*\d+\s*\/\s*\d+\s*$/gm, (match) => {
        const value = match.trim();
        return /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(value) ? match : "";
      });


    resumeText = removePageNumbers(resumeText);

    const driverLicense = extractDriverLicense(resumeText);

    const education = extractSection(resumeText, [
      "formação acadêmica",
      "formacao academica",
      "educação",
      "educacao",
      "formação",
      "formacao",
    ]);

    const educationFormatted = education
      ? education
          .replace(/\b\d+\s*\/\s*\d+\b/g, "")
          .replace(/\s+(?=(?:MBA|BACHARELADO|LICENCIATURA|TECNÓLOGO|TECNOLOGO|GRADUAÇÃO|GRADUACAO|PÓS-GRADUAÇÃO|POS-GRADUACAO|ESPECIALIZAÇÃO|ESPECIALIZACAO|MESTRADO|DOUTORADO)\b)/gi, "\n\n")
          .replace(/[ \t]+/g, " ")
          .replace(/\n[ \t]+/g, "\n")
          .replace(/\n{3,}/g, "\n\n")
          .trim()
      : undefined;

    const experienceRaw = extractSection(resumeText, [
      "experiência profissional",
      "experiencia profissional",
      "experiência",
      "experiencia",
    ]);

    const experience = experienceRaw
      ? experienceRaw
          .replace(/\\s+(Período\\s+)/gi, "\\n\\n$1")
          .replace(
            /\\s+(?=(?:GERENTE|ADMINISTRADOR(?:A)?|ASSISTENTE|ANALISTA|COORDENADOR(?:A)?|SUPERVISOR(?:A)?|AUXILIAR|DIRETOR(?:A)?|CONSULTOR(?:A)?|VENDEDOR(?:A)?|ESTAGIÁRIO(?:A)?|ESTAGIARIA)\\s)/gi,
            "\\n\\n"
          )
          .replace(/[ \t]+/g, " ")
          .replace(/\n[ \t]+/g, "\n")
          .replace(/\n{3,}/g, "\n\n")
          .trim()
      : undefined;

    const skills = extractSkills(resumeText);
    const languages = extractLanguages(resumeText);
    const desiredRoles = extractDesiredRoles(resumeText);

    const result: ResumeExtraction = {
      name: extractName(resumeText),
      email: extractEmail(resumeText),
      phone: extractPhone(resumeText),
      city: extractCity(resumeText),
      desiredRole: desiredRoles,
      desiredRoles,
      linkedin: extractLinkedin(resumeText),
      portfolio: extractPortfolio(resumeText),
      education: educationFormatted,
      courses: extractSection(resumeText, [
        "cursos e certificações",
        "cursos e certificacoes",
        "cursos",
        "certificações",
        "certificacoes",
      ]),
      experience,
      skills,
      languages,
      salaryExpectation: extractSalary(resumeText),
      hasDriverLicense: driverLicense.hasDriverLicense,
      driverLicenseCategory: driverLicense.driverLicenseCategory,
      birthDate: extractBirthDate(resumeText),
      gender: extractGender(resumeText),
      race: extractRace(resumeText),
      sexualOrientation: extractSexualOrientation(resumeText),
      genderIdentity: extractGenderIdentity(resumeText),
      country: "Brasil",
      summary: "",
    };

    let professionalSummary = buildSummary(result, resumeText);

    professionalSummary = professionalSummary
      .replace(/(?:^|\\s)(?:cargo\\(s\\)|cargos?)\\s+de\\s+interesse\\s*:?/gi, " ")
      .replace(/(?:^|\\s)cargo\\s+pretendido\\s*:?/gi, " ")
      .replace(/\\s+/g, " ")
      .replace(/\\s+([.,;])/g, "$1")
      .trim();

    result.summary = professionalSummary || "Não informado";
    result.professionalSummary = result.summary;

    return result;
  }

  async matchCandidateToJob(
    job: Pick<
      Job,
      "title" | "description" | "requirements" | "niceToHave" | "salaryMin" | "salaryMax"
    >,
    candidate: Pick<
      Candidate,
      "name"
      | "experience"
      | "education"
      | "courses"
      | "skills"
      | "languages"
      | "professionalSummary"
      | "salaryExpectation"
    >,
    _resumeText?: string
  ): Promise<CandidateJobAnalysis> {
    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^\w\s.+#/-]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    const comparison = (value: string) =>
      normalize(value)
        .replace(/[.+#/-]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    /*
     * Todo o conteúdo profissional do candidato é considerado.
     * A origem da informação serve apenas para explicar a evidência.
     */
    const sources = [
      {
        name: "Habilidades",
        text: normalize(candidate.skills || ""),
      },
      {
        name: "Experiência profissional",
        text: normalize(candidate.experience || ""),
      },
      {
        name: "Cursos",
        text: normalize(candidate.courses || ""),
      },
      {
        name: "Formação",
        text: normalize(candidate.education || ""),
      },
      {
        name: "Resumo profissional",
        text: normalize(candidate.professionalSummary || ""),
      },
      {
        name: "Idiomas",
        text: normalize(candidate.languages || ""),
      },
    ].filter((source) => source.text);

    const candidateText = sources
      .map((source) => source.text)
      .join(" ");

    const experienceText = normalize(candidate.experience || "");

    const requiredRequirements = (job.requirements || "")
      .split(/[,;\n]/)
      .map((item) => item.trim())
      .filter(Boolean);

    const niceToHaveRequirements = (job.niceToHave || "")
      .split(/[,;\n]/)
      .map((item) => item.trim())
      .filter(Boolean);

    /*
     * Equivalências comuns.
     */
    const aliases: Record<string, string[]> = {
      node: ["nodejs", "node js"],
      nodejs: ["node", "node js"],
      javascript: ["js"],
      js: ["javascript"],
      typescript: ["ts"],
      ts: ["typescript"],
      postgres: ["postgresql"],
      postgresql: ["postgres"],
      powerbi: ["power bi"],
      "power bi": ["powerbi"],
      excel: ["microsoft excel"],
      "microsoft excel": ["excel"],
    };

    function getTerms(value: string): string[] {
      const normalized = comparison(value);

      return [
        normalized,
        ...(aliases[normalized] || []).map(comparison),
      ].filter(Boolean);
    }

    function containsTerm(text: string, term: string): boolean {
      const normalizedText = comparison(text);
      const terms = getTerms(term);

      return terms.some((candidateTerm) => {
        if (!candidateTerm) return false;

        const escaped = candidateTerm.replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&"
        );

        return new RegExp(
          `(^|\\s)${escaped}(?=\\s|$)`,
          "i"
        ).test(normalizedText);
      });
    }

    function matchesRequirement(requirement: string): boolean {
      const normalizedRequirement = comparison(requirement);

      if (!normalizedRequirement) return false;

      /*
       * Requisitos compostos como:
       * "Microsoft Excel e SQL"
       * "Excel avançado"
       * "experiência em vendas B2B"
       *
       * Primeiro tenta a expressão completa.
       */
      if (containsTerm(candidateText, normalizedRequirement)) {
        return true;
      }

      /*
       * Verifica aliases.
       */
      if (
        getTerms(normalizedRequirement).some((term) =>
          containsTerm(candidateText, term)
        )
      ) {
        return true;
      }

      /*
       * Para requisitos compostos, exige as palavras importantes.
       * Palavras genéricas são ignoradas.
       */
      const ignoredWords = new Set([
        "com",
        "em",
        "de",
        "da",
        "do",
        "das",
        "dos",
        "para",
        "por",
        "na",
        "no",
        "nas",
        "nos",
        "experiencia",
        "conhecimento",
        "conhecimentos",
        "dominio",
        "profissional",
        "profissionais",
        "minimo",
        "minima",
        "anos",
      ]);

      const words = normalizedRequirement
        .split(/\s+/)
        .filter(
          (word) =>
            word.length >= 3 &&
            !ignoredWords.has(word)
        );

      if (words.length === 0) return false;

      return words.every((word) =>
        containsTerm(candidateText, word)
      );
    }

    function findRequirementSource(requirement: string): string | null {
      for (const source of sources) {
        if (matchesTextAgainstRequirement(source.text, requirement)) {
          return source.name;
        }
      }

      return null;
    }

    function matchesTextAgainstRequirement(
      text: string,
      requirement: string
    ): boolean {
      const normalizedRequirement = comparison(requirement);

      if (!normalizedRequirement) return false;

      if (containsTerm(text, normalizedRequirement)) {
        return true;
      }

      if (
        getTerms(normalizedRequirement).some((term) =>
          containsTerm(text, term)
        )
      ) {
        return true;
      }

      const ignoredWords = new Set([
        "com",
        "em",
        "de",
        "da",
        "do",
        "das",
        "dos",
        "para",
        "por",
        "na",
        "no",
        "nas",
        "nos",
        "experiencia",
        "conhecimento",
        "conhecimentos",
        "dominio",
        "profissional",
        "profissionais",
        "minimo",
        "minima",
        "anos",
      ]);

      const words = normalizedRequirement
        .split(/\s+/)
        .filter(
          (word) =>
            word.length >= 3 &&
            !ignoredWords.has(word)
        );

      if (words.length <= 1) {
        return words.length === 1
          ? containsTerm(text, words[0])
          : false;
      }

      return words.every((word) => containsTerm(text, word));
    }

    /*
     * ---------------------------------------------------------
     * DETECÇÃO DE TIPOS DE REQUISITO
     * ---------------------------------------------------------
     */

    type RequirementType =
      | "duration"
      | "context"
      | "language_level"
      | "education"
      | "skill"
      | "experience"
      | "general";

    function classifyRequirement(
      requirement: string
    ): RequirementType {
      const r = normalize(requirement);

      if (
        /\b\d+\s*(anos?|meses?)\b/.test(r) ||
        /\b(minimo|minima|pelo menos)\b.*\b(anos?|meses?)\b/.test(r)
      ) {
        return "duration";
      }

      if (
        /\b(startup|startups|scale.?up|empresa de tecnologia|ambiente de startup)\b/.test(
          r
        )
      ) {
        return "context";
      }

      if (
        /\b(ingles|espanhol|frances|alemao|idioma)\b/.test(r) &&
        /\b(basico|intermediario|avancado|fluente|fluencia)\b/.test(r)
      ) {
        return "language_level";
      }

      if (
        /\b(formacao|graduacao|bacharelado|tecnologo|curso superior|ensino superior)\b/.test(
          r
        )
      ) {
        return "education";
      }

      if (
        /\b(experiencia|atuacao|vivencia)\b/.test(r)
      ) {
        return "experience";
      }

      const commonSkills = [
        "excel",
        "sql",
        "python",
        "java",
        "javascript",
        "typescript",
        "react",
        "node",
        "nodejs",
        "aws",
        "docker",
        "kubernetes",
        "power bi",
        "powerbi",
        "salesforce",
        "sap",
      ];

      if (
        commonSkills.some((skill) =>
          r.includes(skill)
        )
      ) {
        return "skill";
      }

      return "general";
    }

    /*
     * ---------------------------------------------------------
     * TEMPO DE EXPERIÊNCIA
     * ---------------------------------------------------------
     *
     * Tenta calcular períodos no formato:
     * 2021 - 2024
     * 03/2021 - 08/2024
     * 2021 até 2025
     *
     * Se não houver datas suficientes, procura frases como:
     * "5 anos de experiência".
     */

    function estimateExperienceMonths(): number | null {
      const explicitYears = experienceText.match(
        /(\d+(?:[.,]\d+)?)\s*(anos?|ano)\s*(?:de)?\s*(?:experiencia|experiência)?/i
      );

      if (explicitYears) {
        const years = Number(
          explicitYears[1].replace(",", ".")
        );

        if (Number.isFinite(years)) {
          return Math.round(years * 12);
        }
      }

      const ranges = [
        /(?:19|20)\d{2}\s*[-–]\s*(?:19|20)\d{2}/g,
        /\d{1,2}\/(?:19|20)\d{2}\s*[-–]\s*(?:\d{1,2}\/)?(?:19|20)\d{2}/g,
      ];

      let totalMonths = 0;

      for (const regex of ranges) {
        const matches = experienceText.match(regex);

        if (!matches) continue;

        for (const range of matches) {
          const years = range.match(
            /(?:19|20)\d{2}/g
          );

          if (!years || years.length < 2) continue;

          const start = Number(years[0]);
          const end = Number(years[1]);

          if (
            Number.isFinite(start) &&
            Number.isFinite(end) &&
            end >= start
          ) {
            totalMonths += (end - start) * 12;
          }
        }

        if (totalMonths > 0) break;
      }

      return totalMonths > 0 ? totalMonths : null;
    }

    function requiredExperienceMonths(
      requirement: string
    ): number | null {
      const match = normalize(requirement).match(
        /(\d+(?:[.,]\d+)?)\s*(anos?|ano|meses?|mes)\b/
      );

      if (!match) return null;

      const amount = Number(
        match[1].replace(",", ".")
      );

      if (!Number.isFinite(amount)) return null;

      return match[2].startsWith("mes")
        ? Math.round(amount)
        : Math.round(amount * 12);
    }

    /*
     * ---------------------------------------------------------
     * CONTEXTO PROFISSIONAL
     * ---------------------------------------------------------
     *
     * "Experiência em startup" só é considerado atendido
     * quando existe evidência textual real.
     *
     * Não assumimos que uma empresa é startup apenas pelo nome.
     */
    function hasStartupEvidence(): boolean {
      const startupTerms = [
        "startup",
        "startups",
        "scale up",
        "scale-up",
        "ambiente de startup",
        "empresa startup",
        "empresa de tecnologia em crescimento",
      ];

      return startupTerms.some((term) =>
        containsTerm(candidateText, term)
      );
    }

    /*
     * ---------------------------------------------------------
     * IDIOMAS E NÍVEIS
     * ---------------------------------------------------------
     */
    const levelRank: Record<string, number> = {
      basico: 1,
      intermediario: 2,
      avancado: 3,
      fluente: 4,
      fluencia: 4,
    };

    function getLanguageLevel(
      language: string,
      text: string
    ): number | null {
      const normalizedLanguage = normalize(language);

      const languageRegex = new RegExp(
        `${normalizedLanguage.replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&"
        )}.{0,40}`,
        "i"
      );

      const match = text.match(languageRegex);

      if (!match) return null;

      for (const [level, rank] of Object.entries(levelRank)) {
        if (match[0].includes(level)) {
          return rank;
        }
      }

      return null;
    }

    function languageRequirementMet(
      requirement: string
    ): boolean {
      const r = normalize(requirement);

      const languages = [
        "ingles",
        "espanhol",
        "frances",
        "alemao",
      ];

      const language = languages.find((item) =>
        r.includes(item)
      );

      if (!language) return matchesRequirement(requirement);

      const requiredLevel = Object.entries(levelRank).find(
        ([level]) => r.includes(level)
      );

      if (!requiredLevel) {
        return containsTerm(candidateText, language);
      }

      const candidateLevel = getLanguageLevel(
        language,
        candidateText
      );

      return (
        candidateLevel !== null &&
        candidateLevel >= requiredLevel[1]
      );
    }

    /*
     * ---------------------------------------------------------
     * FORMAÇÃO
     * ---------------------------------------------------------
     */
    const educationTerms = [
      "administracao",
      "contabilidade",
      "economia",
      "engenharia",
      "computacao",
      "tecnologia",
      "sistemas de informacao",
      "sistemas",
      "marketing",
      "design",
      "direito",
      "psicologia",
      "recursos humanos",
      "gestao",
      "logistica",
      "estatistica",
      "matematica",
      "comunicacao",
      "publicidade",
      "jornalismo",
    ];

    function educationRequirementMet(
      requirement: string
    ): boolean {
      const r = normalize(requirement);
      const candidateEducation = normalize(
        candidate.education || ""
      );

      const matchingTerm = educationTerms.find(
        (term) =>
          r.includes(term) &&
          candidateEducation.includes(term)
      );

      if (matchingTerm) return true;

      return matchesRequirement(requirement);
    }

    /*
     * ---------------------------------------------------------
     * AVALIAÇÃO DE CADA REQUISITO
     * ---------------------------------------------------------
     */

    function requirementMet(
      requirement: string
    ): boolean {
      const type = classifyRequirement(requirement);

      if (type === "duration") {
        const requiredMonths =
          requiredExperienceMonths(requirement);

        const candidateMonths =
          estimateExperienceMonths();

        if (
          requiredMonths !== null &&
          candidateMonths !== null
        ) {
          return candidateMonths >= requiredMonths;
        }

        /*
         * Se não conseguimos calcular, procuramos
         * evidência textual, mas não inventamos.
         */
        return matchesRequirement(requirement);
      }

      if (type === "context") {
        const r = normalize(requirement);

        if (r.includes("startup")) {
          return hasStartupEvidence();
        }

        return matchesRequirement(requirement);
      }

      if (type === "language_level") {
        return languageRequirementMet(requirement);
      }

      if (type === "education") {
        return educationRequirementMet(requirement);
      }

      return matchesRequirement(requirement);
    }

    const requirementsFound =
      requiredRequirements.filter(requirementMet);

    const requirementsMissing =
      requiredRequirements.filter(
        (requirement) => !requirementMet(requirement)
      );

    const niceToHaveFound =
      niceToHaveRequirements.filter(requirementMet);

    /*
     * ---------------------------------------------------------
     * EXPERIÊNCIA RELACIONADA
     * ---------------------------------------------------------
     */
    const experienceMatches =
      requiredRequirements.filter((requirement) => {
        const type = classifyRequirement(requirement);

        if (
          type === "context" ||
          type === "duration"
        ) {
          return requirementMet(requirement);
        }

        const normalizedRequirement =
          comparison(requirement);

        if (!normalizedRequirement) return false;

        return matchesTextAgainstRequirement(
          experienceText,
          requirement
        );
      });

    const hasRelevantExperience =
      experienceMatches.length > 0 ||
      (
        experienceText.length > 0 &&
        normalize(job.title || "")
          .split(/\s+/)
          .filter((word) => word.length >= 5)
          .some((word) =>
            containsTerm(experienceText, word)
          )
      );

    /*
     * ---------------------------------------------------------
     * FORMAÇÃO DA VAGA
     * ---------------------------------------------------------
     */
    const jobAcademicText = normalize(
      `${job.title || ""} ${job.description || ""} ${
        job.requirements || ""
      }`
    );

    const educationRequired =
      educationTerms.some((term) =>
        jobAcademicText.includes(term)
      ) ||
      /\b(formacao|graduacao|curso superior|bacharelado|tecnologo|ensino superior)\b/.test(
        jobAcademicText
      );

    const educationMatches =
      educationTerms.some(
        (term) =>
          normalize(candidate.education || "").includes(term) &&
          jobAcademicText.includes(term)
      );

    /*
     * ---------------------------------------------------------
     * PONTUAÇÃO
     * ---------------------------------------------------------
     *
     * Obrigatórios: 55
     * Diferenciais: 15
     * Experiência:  15
     * Formação:     10
     * Currículo:      5
     *
     * O campo onde a informação foi encontrada NÃO altera
     * a pontuação.
     */
    const requiredScore =
      requiredRequirements.length > 0
        ? (
            requirementsFound.length /
            requiredRequirements.length
          ) * 55
        : 55;

    const niceToHaveScore =
      niceToHaveRequirements.length > 0
        ? (
            niceToHaveFound.length /
            niceToHaveRequirements.length
          ) * 15
        : 15;

    const experienceScore =
      hasRelevantExperience ? 15 : 0;

    const educationScore =
      !educationRequired
        ? 10
        : educationMatches
          ? 10
          : 0;

    const informationScore =
      candidateText.length > 0 ? 5 : 0;

    let matchScore = Math.round(
      requiredScore +
      niceToHaveScore +
      experienceScore +
      educationScore +
      informationScore
    );

    /*
     * Salário acima do teto reduz a compatibilidade,
     * mas não elimina a compatibilidade técnica.
     */
    const salaryAboveMaximum =
      candidate.salaryExpectation !== null &&
      candidate.salaryExpectation !== undefined &&
      job.salaryMax !== null &&
      job.salaryMax !== undefined &&
      candidate.salaryExpectation > job.salaryMax;

    const concerns = requirementsMissing.map(
      (requirement) => {
        const type = classifyRequirement(requirement);

        if (type === "context") {
          return `${requirement} — evidência não identificada no currículo`;
        }

        if (type === "duration") {
          return `${requirement} — tempo de experiência suficiente não identificado`;
        }

        return requirement;
      }
    );

    if (salaryAboveMaximum) {
      concerns.push(
        `Pretensão salarial acima do máximo da vaga (R$ ${candidate.salaryExpectation!.toLocaleString(
          "pt-BR",
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }
        )} vs. máximo de R$ ${job.salaryMax!.toLocaleString(
          "pt-BR",
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }
        )})`
      );

      matchScore = Math.max(
        0,
        matchScore - 10
      );
    }

    /*
     * ---------------------------------------------------------
     * FORÇAS + EVIDÊNCIAS
     * ---------------------------------------------------------
     */
    const strengths = [
      ...requirementsFound.map((requirement) => {
        const source =
          findRequirementSource(requirement);

        const type =
          classifyRequirement(requirement);

        if (type === "duration") {
          const months =
            estimateExperienceMonths();

          if (months !== null) {
            return `${requirement} — aproximadamente ${Math.floor(
              months / 12
            )} anos de experiência identificados`;
          }
        }

        if (source) {
          return `${requirement} — encontrado em ${source}`;
        }

        return requirement;
      }),

      ...niceToHaveFound.map((requirement) => {
        const source =
          findRequirementSource(requirement);

        return source
          ? `${requirement} — encontrado em ${source} (diferencial)`
          : `${requirement} (diferencial)`;
      }),
    ];

    if (hasRelevantExperience) {
      strengths.push(
        "Experiência profissional relacionada à vaga"
      );
    }

    if (educationMatches) {
      strengths.push(
        "Formação compatível com a vaga"
      );
    }

    let summary: string;

    if (matchScore >= 80) {
      summary =
        `${candidate.name} apresenta alta compatibilidade com a vaga, ` +
        `atendendo à maior parte dos requisitos e critérios avaliados.`;
    } else if (matchScore >= 60) {
      summary =
        `${candidate.name} apresenta boa compatibilidade com a vaga, ` +
        `mas possui alguns pontos que devem ser avaliados pelo recrutador.`;
    } else if (matchScore >= 40) {
      summary =
        `${candidate.name} apresenta compatibilidade parcial com a vaga ` +
        `e possui alguns requisitos ou critérios importantes não identificados.`;
    } else {
      summary =
        `${candidate.name} apresenta baixa compatibilidade com os critérios ` +
        `informados para esta vaga.`;
    }

    return {
      summary,
      strengths: strengths.slice(0, 10),
      concerns: concerns.slice(0, 10),
      requirementsFound,
      requirementsMissing,
      relevantExperience: candidate.experience
        ? [candidate.experience.slice(0, 500)]
        : [],
      suggestedQuestions: [
        `Conte sobre sua experiência relacionada à vaga de ${job.title}.`,
        "Quais competências exigidas pela vaga você utiliza na prática?",
        "Existe algum requisito da vaga com o qual você ainda não teve experiência profissional?",
      ],
      matchScore: Math.min(
        100,
        Math.max(0, matchScore)
      ),
      disclaimer: DISCLAIMER,
    };
  }

  async generateCandidateSummary(
    candidate: Pick<Candidate, "name" | "experience" | "education" | "skills">
  ): Promise<string> {
    const skills = candidate.skills
      ? candidate.skills
          .split(/[,;\n]/)
          .map((skill) => skill.trim())
          .filter(Boolean)
          .slice(0, 5)
          .join(", ")
      : "";

    return `${candidate.name} possui formação em ${
      candidate.education || "área não informada"
    }${
      skills ? ` e experiência/habilidades em ${skills}` : ""
    }. ${
      candidate.experience
        ? candidate.experience.slice(0, 300)
        : "Experiência profissional não informada."
    }`;
  }

  async generateInterviewQuestions(
    job: Pick<Job, "title" | "requirements">,
    candidate: Pick<Candidate, "experience" | "skills">
  ): Promise<string[]> {
    const skills = candidate.skills
      ? candidate.skills
          .split(/[,;\n]/)
          .map((skill) => skill.trim())
          .filter(Boolean)
          .slice(0, 3)
      : [];

    return [
      `Conte sobre uma experiência relacionada à vaga de ${job.title}.`,
      "Qual foi um dos maiores desafios da sua experiência profissional?",
      "Como você costuma resolver problemas no trabalho?",
      ...skills.map((skill) => `Qual sua experiência prática com ${skill}?`),
    ];
  }
}

export const aiService = new AIService();
