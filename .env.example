# Banco de dados — Neon PostgreSQL (Serverless Driver via @prisma/adapter-neon).
# Desenvolvimento local: use a connection string do branch de dev do Neon.
# Produção (Cloudflare): mesma variável, com a URL do branch de produção.
# Formato: postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Para `prisma migrate` prefira a URL direta (sem -pooler); em runtime a
# URL com -pooler é aceitável.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# IA (opcional — se não configurado, o sistema usa um mock funcional)
ANTHROPIC_API_KEY=""

# Google Calendar (opcional — sem isso, a conexão com o Google fica indisponível)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Cron de lembretes (rota /api/cron/reminders exige header x-cron-secret)
CRON_SECRET=""
